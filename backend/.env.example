# For `npm run dev` on a host: copy to .env and fill in. Never commit .env.
# Every other variable is in backend/README.md: Google sign-in under Identity, the secret
# store, the feed key and model keys under Secrets, the card service under Settings,
# corrections and model keys. The Docker stack's are in ../.env.docker.example.

# The app logs in as the runtime role: no DDL, only the DML each table grants it.
BWAT_DB_URL=postgres://bwat_runtime:change-me@127.0.0.1:5432/bwat

# The owner role, used only by `npm run migrate`. Never give this one to the app.
BWAT_OWNER_DB_URL=postgres://bwat_owner:change-me@127.0.0.1:5432/bwat

# Where the server listens.
HOST=127.0.0.1
PORT=3000

# How you sign in on a host, without Google: set (32+ characters), a caller presenting
# `Authorization: Bearer <it>` is the dev member (owner if the stack has none). Refused
# unless NODE_ENV is development or test. Never set it on a deployed install.
# BWAT_DEV_PERSON_TOKEN=

# Tests only, and only in backend/.env.test: a SUPERUSER URL for a throwaway
# Postgres 16. The tests create their own roles and a fresh database per file.
# BWAT_TEST_DB_URL=postgres://postgres:change-me@127.0.0.1:5434/postgres
