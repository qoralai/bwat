#!/usr/bin/env bash
# Ask for the Zoom credentials the owner copies back after creating the app
# from setup/zoom-manifest, one app at a time, and write them as a seed file for
# the backend's seed-secrets, which stores them and deletes the file.
#
#   setup/zoom-secrets .bwat/zoom-seed.json
#
# Secrets are read without echo; the Client IDs and the Account ID are not secrets (they
# show in Zoom's sign-in links), so they echo as typed. The file is mode 600. The event secret is asked for only
# in production mode (BWAT_MODE=production), the one install Zoom can reach. The
# Server-to-Server app is optional in every mode: Enter at its Account ID skips it.
# The board app's secret is asked for only with BWAT_BOARD_APP=1: an install at
# http://localhost has no board app.
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: setup/zoom-secrets <seed-file>" >&2
  exit 2
fi
seed=$1
# The click paths come from the onboarding master, by name; found from any directory.
paths=$(dirname "$0")/paths

json=
# One credential: asked (a secret, $3, without echo), checked, added to the seed.
take() {
  local name=$1 where=$2 secret=${3:-} value
  printf '  %s (%s): ' "$where" "$name" >&2
  if [ -n "$secret" ]; then
    IFS= read -rs value
    echo >&2
  else
    IFS= read -r value
  fi
  if [ -z "$value" ] && [ "$name" = zoom.s2s_account_id ]; then
    return 1
  fi
  # Zoom's credentials are plain tokens; anything else is a bad paste, and
  # refusing it means no value ever needs JSON escaping.
  if [[ ! $value =~ ^[A-Za-z0-9._~-]+$ ]]; then
    echo "$name: expected letters, digits and . _ ~ - only; nothing written" >&2
    exit 2
  fi
  json+="${json:+,}\"$name\":\"$value\""
}

cat >&2 <<EOF
Open the bwat app you just created, at $($paths zoom-app-credentials):
EOF
take zoom.client_id "Client ID"
take zoom.client_secret "Client Secret" secret
if [ "${BWAT_MODE:-}" = production ]; then
  echo "Then, in the same app: $($paths zoom-event-secret)" >&2
  take zoom.webhook_secret "Secret Token" secret
fi

if [ -n "${BWAT_BOARD_APP:-}" ]; then
  cat >&2 <<EOF

Now open the board app, at $($paths zoom-app-credentials) (the Beta Test runs on the
Production credentials). bwat uses its Client Secret to read who opens the board inside Zoom:
EOF
  take zoom.board_client_secret "Client Secret" secret
fi

cat >&2 <<EOF

Now open your Server-to-Server OAuth app (optional, recommended: bwat then records your account's
meetings without the host allowing it; Enter to skip). Auto-join needs it too.
To create one: $($paths zoom-s2s-new), name it 'bwat s2s'. Fill the required Information fields,
add scopes meeting:read:meeting:admin, meeting:read:local_recording_token:admin and user:read:user:admin, then Activate it.
Its $($paths zoom-s2s-credentials) shows Account ID, Client ID and Client Secret. An existing
Server-to-Server app in the same account with those scopes also works.
EOF
if take zoom.s2s_account_id "Account ID"; then
  take zoom.s2s_client_id "Client ID"
  take zoom.s2s_client_secret "Client Secret" secret
fi

umask 077
rm -f "$seed"
printf '{%s}\n' "$json" > "$seed"
echo "wrote $seed" >&2
