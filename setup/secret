#!/usr/bin/env bash
# Save a secret to bwat.answers from the clipboard, so it is never typed or shown.
#
#   ./bwat secret KEY    copy the value first; KEY is one of bwat.answers' lines, such
#                        as ZOOM_CLIENT_SECRET. Prints only its last four characters,
#                        then clears the clipboard.
#   ./bwat secret KEY -  reads the value from stdin instead (the onboarding page's
#                        server, setup/onboard), and leaves the clipboard alone.
set -euo pipefail
cd "$(dirname "$0")/.."

[ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = - ]; } || { echo "usage: ./bwat secret KEY [-]" >&2; exit 2; }
key=$1
from_stdin=${2:-}
# The onboarding server names its answers file; it is the clone's own unless told otherwise.
file=${BWAT_ANSWERS:-bwat.answers}
if [[ ! $key =~ ^[A-Z0-9_]+$ ]] || ! grep -q "^$key=" "$file" 2> /dev/null; then
  echo "$file has no $key= line; run ./bwat prep, then name a key from it" >&2
  exit 2
fi

umask 077
# macOS; then Windows (Git Bash or WSL); then Linux under Wayland or X.
if [ -n "$from_stdin" ]; then
  clip_read() { cat; }
  clip_clear() { :; }
elif command -v pbpaste > /dev/null; then
  clip_read() { pbpaste; }
  clip_clear() { pbcopy < /dev/null; }
elif command -v powershell.exe > /dev/null; then
  clip_read() { powershell.exe -NoProfile -Command Get-Clipboard; }
  clip_clear() { printf '' | clip.exe; }
elif command -v wl-paste > /dev/null; then
  clip_read() { wl-paste; }
  clip_clear() { wl-copy --clear; }
else
  clip_read() { xclip -o -selection clipboard; }
  clip_clear() { xclip -selection clipboard < /dev/null; }
fi
# One line in bwat.answers: a copied newline, or Windows' \r, is dropped.
value=$(clip_read 2> /dev/null | tr -d '\r\n') || value=
if [ -z "$value" ] && [ -n "$from_stdin" ]; then
  echo "nothing on stdin for $key; nothing was saved" >&2
  exit 2
fi
if [ -z "$value" ]; then
  echo "the clipboard is empty: copy the value for $key, then run ./bwat secret $key again" >&2
  exit 2
fi

# Written in place, so the file keeps its mode; printf is a builtin, so the value never
# appears in a process list.
content=
while IFS= read -r line || [ -n "$line" ]; do
  if [[ $line == "$key="* ]]; then line="$key=$value"; fi
  content+="$line"$'\n'
done < "$file"
printf '%s' "$content" > "$file"
echo "saved $key (…${value: -4})"
clip_clear
