# For docker-compose.yml: copy to .env at the repository root and fill in. Never commit .env.
# Passwords go into postgres:// URLs, so use URL-safe characters (e.g. `openssl rand -hex 24`).

# The postgres superuser. The image's first-start init sets it; db-bootstrap logs in with it.
POSTGRES_PASSWORD=change-me

# bwat_owner runs the migrations; bwat_runtime is what the backend logs in as;
# bwat_cards is what the card service logs in as.
BWAT_OWNER_PASSWORD=change-me
BWAT_RUNTIME_PASSWORD=change-me
BWAT_CARDS_PASSWORD=change-me

# Host port for the backend (bound to 127.0.0.1).
BWAT_PORT=3000
# Host port for the edge, the board's front door (bound to 127.0.0.1).
BWAT_EDGE_PORT=8080

# Lets you call people's routes (POST /allocations) with `Authorization: Bearer <it>`
# until the panel's sign-in exists. 32+ characters. Leave empty and they answer 401.
BWAT_DEV_PERSON_TOKEN=

# Local and test stacks only (refused unless NODE_ENV is development or test): more stand-in people for
# multi-member tests, as name:role:token,... (role owner, admin or member; token 32+ of
# A-Za-z0-9._~-). Each token signs in as <name>@test.bwat.invalid. scripts/smoke-test-people.sh
# sets its own; leave this empty.
BWAT_TEST_PEOPLE=

# Google sign-in (optional locally): the web and plugin Desktop OAuth client ids,
# comma-separated, and the Google Workspace domains allowed to sign in. Leave either
# empty and Google sign-in is refused; the dev token above still works. (A deployed,
# NODE_ENV=production install refuses to start without both.) The dev member is created
# as owner only on a stack with no owner yet; after a Google owner it is a plain member.
BWAT_GOOGLE_CLIENT_IDS=
BWAT_ALLOWED_DOMAINS=

# The Zoom app's webhook secret token (tier-2 secret zoom.webhook_secret; backend/README.md, Secrets): the env fallback,
# used while the secret store holds none. Neither: POST /callbacks/zoom/events answers 503.
BWAT_ZOOM_WEBHOOK_SECRET=

# Auto-join's ceiling and whether it waits for the host. Empty is on; only false, 0, no,
# off, n or disabled turn either off. The stored switch (off on a fresh install) still decides.
BWAT_AUTO_JOIN=
BWAT_AUTO_JOIN_REQUIRE_HOST=
# The secret store for model keys and the other tier-2 secrets (D142). Empty means local.
BWAT_SECRET_STORE=
# The local store's key: 32 random bytes as base64 or 64 hex (`openssl rand -base64 32`).
# Only ever here, never in the database. Empty: model-key saves answer 503.
BWAT_ENC_KEY=
# The key every bot's feed token is derived from: 32 random bytes as 64 hex or base64 (`openssl rand -hex 32`).
# Empty locally: no feed tokens. A NODE_ENV=production backend refuses to start without it.
BWAT_FEED_KEY=

# Trust X-Forwarded-For/-Proto from a TLS-terminating proxy in front of the backend and the web
# server (the web server's /embed limits failed tries per client address by it)
# (e.g. Caddy on the compose network): true, or proxy addresses/CIDRs
# (172.16.0.0/12); a hop count is refused. Empty is off: the headers are ignored, as they should be when
# nothing sits in front, since any client could send them.
BWAT_TRUST_PROXY=

# Per-client-IP limits a minute, whole numbers from 1: failed Google sign-ins (default 30;
# a successful one is never counted) and Zoom webhook deliveries (default 600). Empty is the default.
BWAT_RATE_LIMIT_SIGNIN_FAILURES_PER_MIN=
BWAT_RATE_LIMIT_ZOOM_PER_MIN=

# Who may frame the board besides Zoom, for both the backend and the web app, space-separated:
# https://host, https://host:port, https://host:* or a bare scheme such as qv: (e.g. for the
# board inside a plugin's product, what its README says). Empty: Zoom alone.
BWAT_FRAME_ANCESTORS=

# The card service. The backend calls its backend-only routes with this token: 32 random bytes
# (`openssl rand -hex 32`); the same value reaches both. Required.
BWAT_CARDS_BACKEND_TOKEN=
# The card service's own credential (bwc_...), minted once the stack is up with
# `docker compose exec backend node dist/scripts/cards-credential.js --label cards`.
BWAT_CARDS_CREDENTIAL=
# Seconds between the card service's transcript reads. Empty is 3.
BWAT_CARDS_POLL_S=
# The card service's database connections for its API, a pool of at most this many, a whole
# number from 1; a request with none free waits 2 s, then is answered 503 busy. Empty is 20.
BWAT_CARDS_MAX_CONCURRENT=
# The card writer's OpenAI-compatible model API and model, served to the card service by the
# backend. Empty is OpenRouter (https://openrouter.ai/api/v1) and its default model. A model an
# admin picks in Settings replaces BWAT_CARDS_MODEL while this address stays the same.
BWAT_CARDS_MODEL_URL=
BWAT_CARDS_MODEL=

# The install's public URL: the web app's sign-in redirect (<it>/auth/callback) and the board
# link in Send to Claude messages. The web app's Google sign-in also needs the web
# OAuth client id and secret (the id also goes in BWAT_GOOGLE_CLIENT_IDS above) and the
# sign-in cookie key, 32 random bytes as base64 (`openssl rand -base64 32`). Any empty: the
# pages serve and sign-in answers 503.
BWAT_PUBLIC_URL=
BWAT_GOOGLE_CLIENT_ID=
BWAT_GOOGLE_CLIENT_SECRET=
BWAT_SESSION_SECRET=
