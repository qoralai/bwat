--- /dev/null
+++ b/src/events/MeetingChatEvent.h
@@ -0,0 +1,55 @@
+// bwat: the meeting chat, so it joins the transcript. One stdout line per message:
+//   BWAT_CHAT_JSON {"from":"Ada","text":"ship it friday"}
+// The bot's own messages are skipped by user id, which survives a rename.
+#pragma once
+
+#include <cstdio>
+#include <string>
+#include <type_traits>
+
+#include <picojson/picojson.h>
+
+#include "meeting_service_components/meeting_chat_interface.h"
+#include "meeting_service_components/meeting_participants_ctrl_interface.h"
+
+USING_ZOOM_SDK_NAMESPACE
+
+class MeetingChatEvent : public IMeetingChatCtrlEvent {
+public:
+    explicit MeetingChatEvent(IMeetingParticipantsController* participantCtl)
+        : m_participantCtl(participantCtl) {}
+
+    void onChatMsgNotification(IChatMsgInfo* chatMsg, const zchar_t*) override {
+        if (!chatMsg) return;
+        const zchar_t* from = chatMsg->GetSenderDisplayName();
+        const zchar_t* text = chatMsg->GetContent();
+        if (!text || !*text || isSelf(chatMsg)) return;
+        if (!chatMsg->IsChatToAll()) return;  // a private message to the bot stays private
+        picojson::object obj;
+        obj["from"] = picojson::value(from ? std::string(from) : std::string());
+        obj["text"] = picojson::value(std::string(text));
+        printf("BWAT_CHAT_JSON %s\n", picojson::value(obj).serialize().c_str());
+        fflush(stdout);
+    }
+
+    // The rest of the interface, all pure virtual in SDK 7.0.2.5001.
+    void onChatStatusChangedNotification(ChatStatus*) override {}
+    void onChatMsgDeleteNotification(const zchar_t*, SDKChatMessageDeleteType) override {}
+    void onChatMessageEditNotification(IChatMsgInfo*) override {}
+    void onShareMeetingChatStatusChanged(bool) override {}
+    void onFileSendStart(ISDKFileSender*) override {}
+    void onFileReceived(ISDKFileReceiver*) override {}
+    void onFileTransferProgress(SDKFileTransferInfo*) override {}
+
