+// bwat: who is in the meeting, so each participant's audio stream can be named.
+// One stdout line per arrival or departure:
+//   BWAT_PARTICIPANT_JSON {"event":"join","id":"16778240","name":"Ada","is_self":false}
+// The id is the user id the per-participant audio frames carry as their node, sent as a
+// string so no JSON number round trip can change it.
+#pragma once
+
+#include <cstdio>
+#include <string>
+#include <type_traits>
+
+#include <picojson/picojson.h>
+
+#include "meeting_service_components/meeting_participants_ctrl_interface.h"
+
+USING_ZOOM_SDK_NAMESPACE
+
+// `user` may be null on a leave (the SDK has dropped it by then): the name is best
+// effort, and the id still identifies who left.
+inline void emitParticipant(const char* event, unsigned int uid, IUserInfo* user) {
+    const zchar_t* name = user ? user->GetUserName() : nullptr;
+    picojson::object obj;
+    obj["event"] = picojson::value(std::string(event));
+    obj["id"] = picojson::value(std::to_string(uid));
+    obj["name"] = picojson::value(name ? std::string(name) : std::string());
+    obj["is_self"] = picojson::value(user ? user->IsMySelf() : false);
+    printf("BWAT_PARTICIPANT_JSON %s\n", picojson::value(obj).serialize().c_str());
+    fflush(stdout);
+}
+
+// Everyone already in the room: onUserJoin fires only for later arrivals.
+inline void emitParticipantRoster(IMeetingParticipantsController* participantCtl) {
+    IList<unsigned int>* users = participantCtl ? participantCtl->GetParticipantsList() : nullptr;
+    if (!users) return;
+    for (int i = 0; i < users->GetCount(); ++i) {
+        const unsigned int uid = users->GetItem(i);
+        emitParticipant("join", uid, participantCtl->GetUserByUserID(uid));
+    }
+}
+
+class MeetingParticipantsCtrlEvent : public IMeetingParticipantsCtrlEvent {
+public:
+    explicit MeetingParticipantsCtrlEvent(IMeetingParticipantsController* participantCtl)
+        : m_participantCtl(participantCtl) {}
+
+    void onUserJoin(IList<unsigned int>* lstUserID, const zchar_t*) override {
+        if (!lstUserID) return;
+        for (int i = 0; i < lstUserID->GetCount(); ++i) {
+            const unsigned int uid = lstUserID->GetItem(i);
+            emitParticipant("join", uid, m_participantCtl->GetUserByUserID(uid));
+        }
+    }
+
+    void onUserLeft(IList<unsigned int>* lstUserID, const zchar_t*) override {
+        if (!lstUserID) return;
+        for (int i = 0; i < lstUserID->GetCount(); ++i) {
+            const unsigned int uid = lstUserID->GetItem(i);
+            emitParticipant("leave", uid, m_participantCtl->GetUserByUserID(uid));
+        }
+    }
+
+    // The rest of the interface, all pure virtual in SDK 7.0.2.5001.
+    void onHostChangeNotification(unsigned int) override {}
+    void onLowOrRaiseHandStatusChanged(bool, unsigned int) override {}
+    void onUserNamesChanged(IList<unsigned int>*) override {}
+    void onCoHostChangeNotification(unsigned int, bool) override {}
+    void onInvalidReclaimHostkey() override {}
+    void onAllHandsLowered() override {}
+    void onLocalRecordingStatusChanged(unsigned int, RecordingStatus) override {}
+    void onAllowParticipantsRenameNotification(bool) override {}
+    void onAllowParticipantsUnmuteSelfNotification(bool) override {}
+    void onAllowParticipantsStartVideoNotification(bool) override {}
+    void onAllowParticipantsShareWhiteBoardNotification(bool) override {}
+    void onRequestLocalRecordingPrivilegeChanged(LocalRecordingRequestPrivilegeStatus) override {}
+    void onAllowParticipantsRequestCloudRecording(bool) override {}
+    void onInMeetingUserAvatarPathUpdated(unsigned int) override {}
+    void onParticipantProfilePictureStatusChange(bool) override {}
+    void onFocusModeStateChanged(bool) override {}
+    void onFocusModeShareTypeChanged(FocusModeShareType) override {}
+    void onBotAuthorizerRelationChanged(unsigned int) override {}
+    void onVirtualNameTagStatusChanged(bool, unsigned int) override {}
+    void onVirtualNameTagRosterInfoUpdated(unsigned int) override {}
+    // No override on these two: with this SDK's headers they do not override (the build
+    // says so), and the class must still define them where they are pure virtual.
+    void onCreateCompanionRelation(unsigned int, unsigned int) {}
+    void onRemoveCompanionRelation(unsigned int) {}
+    void onGrantCoOwnerPrivilegeChanged(bool) override {}
+
+private:
+    IMeetingParticipantsController* m_participantCtl;
+};
+
+static_assert(!std::is_abstract<MeetingParticipantsCtrlEvent>::value,
+              "MeetingParticipantsCtrlEvent is abstract: the Zoom SDK declares an "
+              "IMeetingParticipantsCtrlEvent member this class does not define");
