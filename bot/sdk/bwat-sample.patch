diff --git a/src/raw_send/BwatPresenceSource.h b/src/raw_send/BwatPresenceSource.h
new file mode 100644
index 0000000..1856da9
--- /dev/null
+++ b/src/raw_send/BwatPresenceSource.h
@@ -0,0 +1,104 @@
+#ifndef BWAT_PRESENCE_SOURCE_H
+#define BWAT_PRESENCE_SOURCE_H
+
+// bwat: the bot's presence frame (D196). One 1280x720 I420 frame, which the bot
+// renders before each join (bwat_bot/presence.py), sent as the bot's video twice a second
+// so a late joiner still gets a picture. Nothing else is ever sent as video, and no audio.
+// Set with bwatSetVideoSource() before Join().
+//
+// Zoom's SDK moved the frame format: up to 7.0.2 each sendVideoFrame() names it; later
+// SDKs drop it there and take it once, in setExternalVideoSource(). The two overloads of
+// each helper below pick whichever call the SDK's headers declare (the int one when both
+// would do), so one patch builds against both.
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "zoom_sdk_def.h"
+#include "rawdata/rawdata_video_source_helper_interface.h"
+
+USING_ZOOM_SDK_NAMESPACE
+
+template <class Sender>
+auto bwatSendFrame(Sender* s, char* frame, int w, int h, int length, int)
+    -> decltype(s->sendVideoFrame(frame, w, h, length, 0, FrameDataFormat_I420_FULL)) {
+    return s->sendVideoFrame(frame, w, h, length, 0, FrameDataFormat_I420_FULL);
+}
+template <class Sender>
+auto bwatSendFrame(Sender* s, char* frame, int w, int h, int length, long)
+    -> decltype(s->sendVideoFrame(frame, w, h, length, 0)) {
+    return s->sendVideoFrame(frame, w, h, length, 0);
+}
+template <class Helper, class Source>
+auto bwatSetVideoSource(Helper* h, Source* source, int)
+    -> decltype(h->setExternalVideoSource(source, FrameDataFormat_I420_FULL)) {
+    return h->setExternalVideoSource(source, FrameDataFormat_I420_FULL);
+}
+template <class Helper, class Source>
+auto bwatSetVideoSource(Helper* h, Source* source, long)
+    -> decltype(h->setExternalVideoSource(source)) {
+    return h->setExternalVideoSource(source);
+}
+
+class BwatPresenceSource : public IZoomSDKVideoSource {
+public:
+    static constexpr int kWidth = 1280, kHeight = 720;
+
+    explicit BwatPresenceSource(const std::string& path) {
+        std::ifstream in(path, std::ios::binary);
+        m_frame.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    }
+    ~BwatPresenceSource() override { stop(); }
+
+    bool ok() const { return m_frame.size() == static_cast<size_t>(kWidth * kHeight * 3 / 2); }
+
+    void onInitialize(IZoomSDKVideoSender* sender, IList<VideoSourceCapability>* caps,
+                      VideoSourceCapability& suggest) override {
+        m_sender = sender;
+        for (int i = 0; caps && i < caps->GetCount(); i++) {
+            auto cap = caps->GetItem(i);
+            if (cap.width == kWidth && cap.height == kHeight) {
+                suggest = cap;
+                return;
+            }
+        }
+        printf("BWAT_MEETING_STATUS_JSON {\"event\":\"presence\",\"code\":\"720p_not_offered\"}\n");
+        fflush(stdout);
+    }
+    void onPropertyChange(IList<VideoSourceCapability>*, VideoSourceCapability) override {}
+
+    void onStartSend() override {
+        if (!ok() || !m_sender || m_sending.exchange(true)) return;
+        m_thread = std::thread([this] {
+            while (m_sending) {
+                bwatSendFrame(m_sender, m_frame.data(), kWidth, kHeight,
+                              static_cast<int>(m_frame.size()), 0);
+                std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            }
+        });
+    }
+    void onStopSend() override { stop(); }
+    void onUninitialized() override {
+        stop();
+        m_sender = nullptr;
+    }
+
+private:
+    void stop() {
+        m_sending = false;
+        if (m_thread.joinable()) m_thread.join();
+    }
+
+    std::vector<char> m_frame;
+    IZoomSDKVideoSender* m_sender = nullptr;
+    std::atomic<bool> m_sending{false};
+    std::thread m_thread;
+};
+
+#endif
