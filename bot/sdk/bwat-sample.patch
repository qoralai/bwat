+// bwat: two triggers start raw recording (a privilege granted at join, and the
+// recording disclaimer accepted). Both arm one retry on the glib loop; a second
+// arm while one is pending does nothing.
+static std::atomic<bool> g_recordingRetryArmed{false};
+
+static gboolean retryStartRecording(gpointer) {
+    static int attempts = 0;
+    auto& zoom = Zoom::getInstance();
+    if (zoom.canStartRawRecording()) {
+        auto err = zoom.startRawRecording();
+        if (err != SDKERR_SUCCESS)
+            Log::error("start raw recording failed (SDKError " + std::to_string((int) err) + ")");
+        attempts = 0;
+        g_recordingRetryArmed = false;
+        return FALSE;
+    }
+    if (++attempts >= 20) {
+        Log::error("start raw recording: gave up waiting for CanStartRawRecording");
+        attempts = 0;
+        g_recordingRetryArmed = false;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+// bwat: the bot's chat posts come in on stdin as `BWAT_CHAT_SEND {"text":...}` lines
+// (bot/container/bridge.py). A reader thread takes them; each send runs on the glib loop,
+// since the SDK drops a chat sent from another thread while still reporting success. At
+// default priority, not idle: the presence frame keeps the loop from ever going idle.
+// Zoom's answer goes back as a chat_sent status line (18 is its per-sender rate limit).
+static std::atomic<bool> g_chatReaderStarted{false};
+
+static gboolean deliverChat(gpointer data) {
+    auto* text = static_cast<std::string*>(data);
+    auto err = Zoom::getInstance().sendChat(*text);
+    printf("BWAT_MEETING_STATUS_JSON {\"event\":\"chat_sent\",\"code\":%d}\n", static_cast<int>(err));
+    fflush(stdout);
+    delete text;
+    return FALSE;
+}
+
+static void readChatCommands() {
+    const std::string prefix = "BWAT_CHAT_SEND ";
+    std::string line;
+    while (std::getline(std::cin, line)) {
+        if (line.rfind(prefix, 0) != 0) continue;
+        picojson::value command;
+        if (!picojson::parse(command, line.substr(prefix.size())).empty() || !command.is<picojson::object>())
+            continue;
+        auto& fields = command.get<picojson::object>();
+        auto text = fields.find("text");
+        if (text == fields.end() || !text->second.is<std::string>()) continue;
+        g_idle_add_full(G_PRIORITY_DEFAULT, deliverChat,
+                        new std::string(text->second.get<std::string>()), nullptr);
+    }
+}
