+SDKError Zoom::sendChat(const string& text) {
+    auto* chatCtl = m_meetingService ? m_meetingService->GetMeetingChatController() : nullptr;
+    auto* builder = chatCtl ? chatCtl->GetChatMessageBuilder() : nullptr;
+    if (!builder) return SDKERR_UNINITIALIZE;
+    auto* msg = builder->SetContent(text.c_str())
+                       ->SetReceiver(0)
+                       ->SetMessageType(SDKChatMessageType_To_All)
+                       ->Build();
+    // One builder per controller, reused: cleared after every message.
+    if (!msg) {
+        builder->Clear();
+        return SDKERR_INVALID_PARAMETER;
+    }
+    auto err = chatCtl->SendChatMsgTo(msg);
+    builder->Clear();
+    return err;
+}
